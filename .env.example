POSTGRES_DB=mediagrid
POSTGRES_USER=mediagrid
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=mediagrid
RABBITMQ_PASSWORD=change-me
# Версия образов служб = версия проекта (см. README)
MEDIAGRID_VERSION=0.7.0
# Первый администратор: создаётся при первом запуске службы авторизации, если администраторов нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# Ключ подписи ссылок на файлы: случайная строка не короче 32 символов (например, openssl rand -base64 48)
STORAGE_LINK_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Секрет службы обработки для входа в службу авторизации (токен службы): не короче 32 символов
PROCESSING_CLIENT_SECRET=change-me-to-another-random-string-of-32-chars
