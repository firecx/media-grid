POSTGRES_DB=mediagrid
POSTGRES_USER=mediagrid
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=mediagrid
RABBITMQ_PASSWORD=change-me
# Версия образов служб = версия проекта (см. README)
MEDIAGRID_VERSION=0.8.0
# Первый администратор: создаётся при первом запуске службы авторизации, если администраторов нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# Ключ подписи ссылок на файлы: случайная строка не короче 32 символов (например, openssl rand -base64 48)
STORAGE_LINK_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Секрет службы обработки для входа в службу авторизации (токен службы): не короче 32 символов
PROCESSING_CLIENT_SECRET=change-me-to-another-random-string-of-32-chars
# Порт веб-интерфейса на этой машине (по умолчанию 80); изменить, если 80 занят
# MEDIAGRID_HTTP_PORT=80
# HTTPS: auto — сертификат из MEDIAGRID_CERTS_DIR (fullchain.pem и privkey.pem) или самоподписанный,
# если их нет; off — только HTTP (разработка на своей машине)
# MEDIAGRID_TLS=auto
# Имя сервера (для самоподписанного сертификата)
# MEDIAGRID_HOSTNAME=media.example.com
# MEDIAGRID_HTTPS_PORT=443
# Каталог с сертификатом; для Let's Encrypt можно указать /etc/letsencrypt и пути внутри него:
# MEDIAGRID_CERTS_DIR=/etc/letsencrypt
# MEDIAGRID_TLS_CERT_FILE=live/media.example.com/fullchain.pem
# MEDIAGRID_TLS_KEY_FILE=live/media.example.com/privkey.pem
# MEDIAGRID_ACME_DIR=/var/www/acme
