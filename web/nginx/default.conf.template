# Единственная точка входа для браузера: интерфейс и /api на одном адресе — куки входа
# (SameSite=Strict, Path=/api/auth) работают без настроек CORS. Шлюз наружу не публикуется.

# Не больше 10 попыток входа в минуту с одного адреса (с запасом 5 подряд); дальше 429
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # DNS docker: адрес шлюза перечитывается, а не запоминается при запуске
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway ${GATEWAY_ADDRESS};

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Заголовки безопасности. В location ниже нет своих add_header, поэтому они действуют везде.
    # style-src 'unsafe-inline': библиотека компонентов задаёт часть оформления встроенными стилями
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        error_page 429 = @too_many_logins;
        include /etc/nginx/mediagrid/proxy.conf;
    }

    location /api/ {
        include /etc/nginx/mediagrid/proxy.conf;
    }

    # Сборка Vite: в именах файлов отпечаток содержимого, их можно кэшировать навсегда
    location /assets/ {
        expires max;
        access_log off;
        try_files $uri =404;
    }

    # Одностраничное приложение: любой другой путь — index.html, маршрут разбирает сам интерфейс.
    # index.html не кэшируется, чтобы после обновления браузер сразу получил новую сборку
    location / {
        expires -1;
        try_files $uri /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location @gateway_down {
        default_type application/json;
        return 503 '{"code":"SERVICE_UNAVAILABLE","message":"Служба временно недоступна, повторите позже","traceId":null,"timestamp":null}';
    }

    location @too_many_logins {
        default_type application/json;
        return 429 '{"code":"TOO_MANY_REQUESTS","message":"Слишком много попыток входа, подождите минуту","traceId":null,"timestamp":null}';
    }
}
